{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legato",
  "version": "1.0.0",
  "identifier": "app.legato.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Legato",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://art.localhost art:; media-src 'self' http://art.localhost art:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.youtube.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": ["third-party-licenses.html"],
    "windows": { "nsis": { "installerHooks": "./windows/hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQTBDQUVEQkFFNUZCODEKUldTQisrVzY3Y3FnektTaUJydEl4OGVHbG8zR205S2YxdlRnUEwya1FwTXhsQTE1V1RDM3RQanAK",
      "endpoints": ["https://github.com/Clovis500c/music-app/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
