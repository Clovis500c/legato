{
  "name": "legato",
  "version": "1.1.0",
  "description": "One library for YouTube Music, Spotify, Apple Music and your own files. Desktop app (Tauri 2 + Rust).",
  "author": "Clovis500c",
  "repository": "github:Clovis500c/legato",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "pnpm notices && tauri build",
    "tauri": "tauri",
    "vite": "vite",
    "types": "node scripts/types.mjs",
    "bench": "node scripts/bench.mjs",
    "e2e": "node e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "check:licenses": "node scripts/licenses.mjs && cargo deny check licenses bans sources",
    "notices": "node scripts/notices.mjs",
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm test && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
