<?xml version="1.0" encoding="utf-8"?>
<!-- The disc widget as the picker shows it (Android 12+): a record, the play and next buttons under it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_disc" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/widget_pill"
        android:orientation="horizontal"
        android:padding="2dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/widget_text" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/widget_text" />
    </LinearLayout>
</FrameLayout>
